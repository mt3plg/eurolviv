{
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|blog-images(?:/|$)|documents(?:/|$)|terrace-assets(?:/|$)|favicon\\.ico|favicon\\.png|robots\\.txt|sitemap\\.xml|sitemap\\.xsl|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    }
  ]
}
